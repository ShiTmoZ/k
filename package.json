{
  "name": "neuroshift",
  "version": "1.0.1",
  "description": "NEUROSHIFT — Cognitive Rewiring & Neural Integrity Clinical Console",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "tauri": "tauri",
    "build:tauri": "tauri build",
    "build:win": "electron-builder --win portable nsis"
  },
  "keywords": [
    "neuroscience",
    "biohacking",
    "dopamine",
    "habit-reversal",
    "cognitive-restructuring",
    "tauri",
    "electron"
  ],
  "author": "ShiTmoZ",
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.shitmoz.neuroshift",
    "productName": "NeuroShift",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "files": [
      "main.js",
      "server.js",
      "lib/**/*",
      "public/**/*",
      "package.json"
    ]
  }
}
